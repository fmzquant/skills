"""TA-Lib (the ``talib`` Python package), available to strategies as ``talib`` (``import talib`` also works).

Inputs are price columns: ``records.Close``, ``records.High`` ... of ``exchange.GetRecords()`` (numpy arrays), or
numpy arrays / lists of floats. Results are numpy arrays; functions with several outputs return a tuple.
``matype``: 0 SMA, 1 EMA, 2 WMA, 3 DEMA, 4 TEMA, 5 TRIMA, 6 KAMA, 7 MAMA, 8 T3.

Example::

    records = exchange.GetRecords()
    macd, signal, hist = talib.MACD(records.Close, 12, 26, 9)
    upper, middle, lower = talib.BBANDS(records.Close, timeperiod=20)
    atr = talib.ATR(records.High, records.Low, records.Close, 14)
"""
from typing import Protocol

class _Real(Protocol):
    """A numeric column: numpy array, list of floats or ``records.Close``-style accessor."""
    def __len__(self) -> int: ...

